[
  {
    "id": "deploy",
    "execute-command": "/usr/local/bin/deploy.sh",
    "response-message": "deploy triggered",
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "__WEBHOOK_SECRET__",
        "parameter": {
          "source": "header",
          "name": "X-Webhook-Secret"
        }
      }
    }
  }
]
