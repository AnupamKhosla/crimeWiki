[mysqld]
# Low-memory settings for e2-micro class VMs (~1 GB RAM).
# This file is mounted into the MySQL container by docker-compose.
# Use it on small servers to avoid RAM pressure and random hangs.
#
# Notes on defaults (vary by MySQL version):
# - innodb_buffer_pool_size: ~128M by default in many builds.
# - max_connections: often 151 by default.
# - tmp_table_size/max_heap_table_size: often 16M by default.
# - sort/join/read buffers: typically 256K–1M defaults.
#
# We keep buffers small and cap connections to fit 1 GB RAM.
innodb_buffer_pool_size = 128M
innodb_log_buffer_size = 8M
max_connections = 50
table_open_cache = 200
tmp_table_size = 32M
max_heap_table_size = 32M
sort_buffer_size = 2M
join_buffer_size = 2M
read_buffer_size = 1M
read_rnd_buffer_size = 1M

[client]
# Client default charset.
default_character_set = utf8mb4
