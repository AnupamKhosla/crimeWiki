{
  "name": " ",
  "version": "0.0.1",
  "description": "",
  "keywords": "",
  "license": "",
  "author": "",
  "scripts": {
    "build": "npm run build:css && parcel build index.html",
    "build:scss": "node-sass assets/scss/style.scss assets/css/style.css --output-style expanded --source-map=false",
    "build:css": "node scripts/build_inline_css.js",
    "build:performance": "npm run build:scss && npm run build:css",
    "dev": "parcel index.html --open",
    "start": "npm run build && npm run dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test2": "npm run scss-compile",
    "scss-compile": "node-sass --source-map-embed -w assets/scss -o assets/css --output-style expanded",
    "watch": "npm run scss-compile"
  },
  "devDependencies": {
    "cssnano": "^4.1.10",
    "parcel-bundler": "^1.12.4"
  },
  "dependencies": {
    "node-sass": "^7.0.0",
    "selectric": "^1.13.0"
  }
}
